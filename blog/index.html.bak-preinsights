    <!-- Hero Section with Search -->
    <section class="hero">
        <h1><i class="fas fa-blog"></i> EPM Cloud Blog</h1>
        <p>Expert insights, implementation guides, and industry updates</p>
        <div class="search-container">
            <input type="text" class="search-input" placeholder="Search blogs..." id="searchInput">
            <i class="fas fa-search search-icon"></i>
        </div>
    </section>

    <!-- Blog Previews -->
    <section class="blog-container">
        <div class="blog-preview" id="blogPreview"></div>
        <div class="show-more-container" id="showMoreContainer">
            <button class="show-more-btn" id="showMoreBtn">Show More</button>
        </div>
        <div class="search-results" id="searchResults"></div>
    </section>

    <!-- Footer -->
    

    <!-- Search, Pagination, and Hamburger JavaScript -->
    <script>
        const blogPosts = [
            { title: "EPM April 2025 Updates", category: "update", date: "April 2025", summary: "Explore the April 2025 Oracle EPM Cloud release, including planning enhancements and integration improvements.", url: "epm-25.04-update.html" },
            { title: "EPBCS 25.03 Updates", category: "update", date: "March 2025", summary: "Enhanced dashboards and analytics integration in the March 2025 release.", url: "epm-25.03-update.html" },
            { title: "EPBCS & Planning 25.02 Updates", category: "update", date: "February 2025", summary: "Security and usability enhancements in the February 2025 release.", url: "epm-25.02-update.html" },
            { title: "EPBCS & Planning 25.01 Updates", category: "update", date: "January 2025", summary: "AI goal suggestions and new workflow templates in the January 2025 release.", url: "epm-25.01-update.html" },
            { title: "Managing User-defined Attributes (UDA) in Groovy", category: "epm", date: "January 2025", summary: "A concise guide to managing UDAs in Groovy scripts - add, remove, replace and edit.", url: "groovy-udaFunctions.html" },
            { title: "EPBCS & Sales Planning 24.12 Updates", category: "update", date: "December 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for December 2024.", url: "epm-24.12-update.html" },
            { title: "EPBCS & Sales Planning 24.11 Updates", category: "update", date: "November 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for November 2024.", url: "epm-24.11-update.html" },
            { title: "Using Grid Builders in Groovy", category: "epm", date: "November 2024", summary: "A practical guide to building data grids with Groovy scripting in EPBCS.", url: "groovy-gridBuilder.html" },
            { title: "EPBCS & Sales Planning 24.10 Updates", category: "update", date: "October 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for October 2024.", url: "epm-24.10-update.html" },
            { title: "EPBCS & Sales Planning 24.09 Updates", category: "update", date: "September 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for September 2024.", url: "epm-24.09-update.html" },
            { title: "EPBCS & Sales Planning 24.08 Updates", category: "update", date: "August 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for August 2024.", url: "epm-24.08-update.html" },
            { title: "EPBCS & Sales Planning 24.07 Updates", category: "update", date: "July 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for July 2024.", url: "epm-24.07-update.html" },
            { title: "Using getEvaluatedMembers in Groovy", category: "epm", date: "July 2024", summary: "Resolving dynamic member sets at runtime in business rules with getEvaluatedMembers.", url: "groovy-getEval.html" },
            { title: "EPBCS & Sales Planning 24.06 Updates", category: "update", date: "June 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for June 2024.", url: "epm-24.06-update.html" },
            { title: "Managing Metadata Updates in EPM Cloud with Groovy", category: "epm", date: "June 2024", summary: "A concise cheatsheet for scripted approaches to keeping dimension metadata in sync.", url: "groovy-updateMeta.html" },
            { title: "EPBCS & Sales Planning 24.05 Updates", category: "update", date: "May 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for May 2024.", url: "epm-24.05-update.html" },
            { title: "EPBCS & Sales Planning 24.04 Updates", category: "update", date: "April 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for April 2024.", url: "epm-24.04-update.html" },
            { title: "EPBCS & Sales Planning 24.03 Updates", category: "update", date: "March 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for March 2024.", url: "epm-24.03-update.html" },
            { title: "Automating Data Loads in EPBCS", category: "epm", date: "March 2024", summary: "Learn how to streamline your EPM processes with Groovy scripts.", url: "post1.html" },
            { title: "EPBCS & Sales Planning 24.02 Updates", category: "update", date: "February 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for February 2024.", url: "epm-24.02-update.html" },
            { title: "EPBCS & Sales Planning 24.01 Updates", category: "update", date: "January 2024", summary: "Detailed analysis of Oracle EPM Cloud updates for January 2024.", url: "epm-24.01-update.html" }
        ];

        const searchInput = document.getElementById('searchInput');
        const blogPreview = document.getElementById('blogPreview');
        const searchResults = document.getElementById('searchResults');
        const showMoreBtn = document.getElementById('showMoreBtn');
        const showMoreContainer = document.getElementById('showMoreContainer');

        const postsPerPage = 8;
        let visiblePosts = postsPerPage;

        // Function to render blog posts
        function renderPosts(startIndex, endIndex) {
            const postsToRender = blogPosts.slice(startIndex, endIndex);
            postsToRender.forEach(post => {
                const card = document.createElement('div');
                card.className = 'blog-card';
                card.innerHTML = `
                    <div class="post-meta">
                        <span class="category ${post.category}">${post.category === 'update' ? 'Cloud Update' : 'EPM Scripting'}</span>
                        <span class="date">${post.date}</span>
                    </div>
                    <h3>${post.title}</h3>
                    <p>${post.summary}</p>
                    <a href="${post.url}" class="read-more">Read More →</a>
                `;
                blogPreview.appendChild(card);
            });
        }

        // Initial render of first 8 posts
        renderPosts(0, visiblePosts);

        // Show More button logic
        if (visiblePosts >= blogPosts.length) {
            showMoreContainer.style.display = 'none';
        }
        showMoreBtn.addEventListener('click', () => {
            const nextPosts = visiblePosts + postsPerPage;
            renderPosts(visiblePosts, nextPosts);
            visiblePosts = nextPosts;

            if (visiblePosts >= blogPosts.length) {
                showMoreContainer.style.display = 'none';
            }
        });

        // Search functionality
        searchInput.addEventListener('input', function() {
            const query = this.value.trim().toLowerCase();
            if (query === '') {
                blogPreview.style.display = 'grid';
                searchResults.style.display = 'none';
                showMoreContainer.style.display = visiblePosts < blogPosts.length ? 'block' : 'none';
                return;
            }

            const results = blogPosts.filter(post =>
                post.title.toLowerCase().includes(query) ||
                post.summary.toLowerCase().includes(query) ||
                post.category.toLowerCase().includes(query)
            );

            blogPreview.style.display = 'none';
            searchResults.style.display = 'block';
            showMoreContainer.style.display = 'none'; // Hide Show More during search
            searchResults.innerHTML = '';

            if (results.length === 0) {
                searchResults.innerHTML = '<p>No results found.</p>';
            } else {
                results.forEach(post => {
                    const card = document.createElement('div');
                    card.className = 'blog-card';
                    card.innerHTML = `
                        <div class="post-meta">
                            <span class="category ${post.category}">${post.category === 'update' ? 'Cloud Update' : 'EPM Scripting'}</span>
                            <span class="date">${post.date}</span>
                        </div>
                        <h3>${post.title}</h3>
                        <p>${post.summary}</p>
                        <a href="${post.url}" class="read-more">Read More →</a>
                    `;
                    searchResults.appendChild(card);
                });
            }
        });

        // Hamburger Menu Toggle
        const hamburger = document.querySelector('.hamburger');
        const navLinks = document.querySelector('.nav-links');
        const navLinksAnchors = navLinks.querySelectorAll('a');

        hamburger.addEventListener('click', () => {
            navLinks.classList.toggle('active');
        });

        // Collapse menu when a link is clicked on mobile
        navLinksAnchors.forEach(anchor => {
            anchor.addEventListener('click', () => {
                if (window.innerWidth <= 768) {
                    navLinks.classList.remove('active');
                }
            });
        });
    </script>
